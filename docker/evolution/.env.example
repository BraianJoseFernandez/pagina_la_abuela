# Clave que Laravel usa para hablar con el gateway: debe coincidir con EVOLUTION_API_KEY del .env del proyecto.
# Generá una larga y aleatoria, por ejemplo con: openssl rand -hex 32
AUTHENTICATION_API_KEY=cambiar-por-una-clave-larga-y-aleatoria

SERVER_URL=http://localhost:8090
EVOLUTION_PORT=8090
LANGUAGE=es

POSTGRES_PASSWORD=evolution_local_password
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_local_password@postgres:5432/evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution_v2
CACHE_LOCAL_ENABLED=false

# No sincronizar el historial completo del teléfono al vincularlo
CONFIG_SESSION_PHONE_CLIENT=La Abuela
CONFIG_SESSION_PHONE_NAME=Chrome
